{
    "driver_vrlink_pfd_mr": {
        "enable": true
    },

    // HMD definition
    "vrlink_yvr_d3": {
        "enable": true,
        "modelNumber": "Play For Dream MR",
        "trackingSystemName": "pfd",
        "manufacturerName": "Play For Dream",
        "renderModelName": "generic_hmd",
        "inputProfilePath": "{oculus}/input/rift_profile.json",
        "controllerType": "rift",
        "deviceType": "pfd/VRLINK_PFD_MR_HMD",
        "serialNumber": "VRLINK_PFD_MR_HMD",
        "resourceRoot": "vrlink_pfd_mr",
        "hasEyeTracking": true,
        "supportsEyeTracking": true,
        "supports10bit": true,
        "recommendedRenderWidth": 3840,
        "recommendedRenderHeight": 3552,
        "minStreamFormatWidth": 512,
        "maxStreamFormatWidth": 1536
    },

    // Left controller definition
    "vrlink_yvr_d3_controller_left": {
        "modelNumber": "Play For Dream MR (Left Controller)",
        "serialNumber": "VRLINK_PFD_MR_CONTROLLER_LEFT",
        "trackingSystemName": "pfd",
        "renderModelName": "{vrlink_pfd_mr}/rendermodels/pfd_mr_controller_left",
        "inputProfilePath": "{vrlink_pfd_mr}/input/pfd_mr_controller_profile.json",
        "controllerType": "pfd_mr_controller",
        "deviceType": "pfd/VRLINK_PFD_MR_CONTROLLER_LEFT",
        "providesOffsetOverride": true,
        "offsetPosX": 0.00,
        "offsetPosY": 0.025,
        "offsetPosZ": -0.035,
        "offsetDegX": 25.00,
        "offsetDegY": 0.00,
        "offsetDegZ": 0.00
    },

    // Right controller definition
    "vrlink_yvr_d3_controller_right": {
        "modelNumber": "Play For Dream MR (Right Controller)",
        "serialNumber": "VRLINK_PFD_MR_CONTROLLER_RIGHT",
        "trackingSystemName": "pfd",
        "renderModelName": "{vrlink_pfd_mr}/rendermodels/pfd_mr_controller_right",
        "inputProfilePath": "{vrlink_pfd_mr}/input/pfd_mr_controller_profile.json",
        "controllerType": "pfd_mr_controller",
        "deviceType": "pfd/VRLINK_PFD_MR_CONTROLLER_RIGHT",
        "providesOffsetOverride": true,
        "offsetPosX": 0.00,
        "offsetPosY": 0.025,
        "offsetPosZ": -0.035,
        "offsetDegX": 25.00,
        "offsetDegY": 0.00,
        "offsetDegZ": 0.00
    }
}param(
    [Parameter(Mandatory, Position = 0)]
    [ValidateSet('GetRuntime', 'AddExternalDriver', 'RemoveExternalDriver')]
    [string] $Command,

    [Parameter(Mandatory)]
    [ValidateNotNullOrEmpty()]
    [string] $File,

    [ValidateNotNullOrEmpty()]
    [string] $DriverPath
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$utf8NoBom = New-Object System.Text.UTF8Encoding($false)

function Resolve-ExistingFilePath {
    param(
        [Parameter(Mandatory)] [ValidateNotNullOrEmpty()] [string] $Path,
        [Parameter(Mandatory)] [ValidateNotNullOrEmpty()] [string] $ParameterName
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "$ParameterName not found: $Path"
    }

    return (Resolve-Path -LiteralPath $Path).Path
}

$resolvedFile = Resolve-ExistingFilePath -Path $File -ParameterName 'File'

function Normalize-DriverPath {
    param([Parameter(Mandatory)] [ValidateNotNullOrEmpty()] [string] $Path)

    $normalized = $Path.Trim()
    while ($normalized.Length -gt 3 -and ($normalized.EndsWith('\') -or $normalized.EndsWith('/'))) {
        $normalized = $normalized.Substring(0, $normalized.Length - 1)
    }

    return $normalized
}

function Get-JsonStringArrayProperty {
    param(
        [Parameter(Mandatory)] [object] $JsonObject,
        [Parameter(Mandatory)] [ValidateNotNullOrEmpty()] [string] $PropertyName,
        [Parameter(Mandatory)] [ValidateNotNullOrEmpty()] [string] $ValidationMessage,
        [switch] $AllowMissing,
        [switch] $AllowNull,
        [switch] $RequireNonEmptyStrings
    )

    $property = $JsonObject.PSObject.Properties[$PropertyName]
    if ($null -eq $property) {
        if ($AllowMissing) {
            return @()
        }

        throw $ValidationMessage
    }

    if ($null -eq $property.Value) {
        if ($AllowNull) {
            return @()
        }

        throw $ValidationMessage
    }

    if ($property.Value -isnot [System.Collections.IList]) {
        throw $ValidationMessage
    }

    $values = New-Object System.Collections.Generic.List[string]
    foreach ($item in $property.Value) {
        if ($item -isnot [string]) {
            throw $ValidationMessage
        }

        if ($RequireNonEmptyStrings -and [string]::IsNullOrWhiteSpace($item)) {
            throw $ValidationMessage
        }

        $values.Add($item)
    }

    return $values.ToArray()
}

function Read-OpenVrPaths {
    $rawJson = [System.IO.File]::ReadAllText($resolvedFile)
    if ([string]::IsNullOrWhiteSpace($rawJson)) {
        throw "OpenVR paths file is empty: $resolvedFile"
    }

    try {
        $json = ConvertFrom-Json -InputObject $rawJson
    }
    catch {
        throw "Failed to parse OpenVR paths JSON from ${resolvedFile}: $($_.Exception.Message)"
    }

    if ($json -isnot [pscustomobject]) {
        throw "OpenVR paths JSON root must be an object: $resolvedFile"
    }

    return $json
}

function Get-RuntimeEntries {
    param([Parameter(Mandatory)] [object] $JsonObject)

    $property = $JsonObject.PSObject.Properties['runtime']
    if ($null -eq $property -or $null -eq $property.Value) {
        throw 'No runtime entry found in openvrpaths.vrpath'
    }

    $runtime = @(Get-JsonStringArrayProperty -JsonObject $JsonObject -PropertyName 'runtime' -ValidationMessage 'runtime must be an array of non-empty strings' -RequireNonEmptyStrings)
    if ($runtime.Count -eq 0) {
        throw 'No runtime entry found in openvrpaths.vrpath'
    }

    return $runtime
}

function Get-ExternalDriverEntries {
    param([Parameter(Mandatory)] [object] $JsonObject)

    return @(Get-JsonStringArrayProperty -JsonObject $JsonObject -PropertyName 'external_drivers' -ValidationMessage 'external_drivers must be null, absent, or an array of strings' -AllowMissing -AllowNull)
}

function Set-JsonArrayProperty {
    param(
        [Parameter(Mandatory)] [object] $JsonObject,
        [Parameter(Mandatory)] [ValidateNotNullOrEmpty()] [string] $PropertyName,
        [Parameter(Mandatory)] [AllowEmptyCollection()] [string[]] $Value
    )

    $arrayValue = @($Value)
    if ($JsonObject.PSObject.Properties.Name -contains $PropertyName) {
        $JsonObject.$PropertyName = $arrayValue
        return
    }

    $JsonObject | Add-Member -NotePropertyName $PropertyName -NotePropertyValue $arrayValue
}

function Write-OpenVrPaths {
    param([Parameter(Mandatory)] [object] $JsonObject)

    Copy-Item -LiteralPath $resolvedFile -Destination "$resolvedFile.bak" -Force
    $jsonText = $JsonObject | ConvertTo-Json -Depth 8
    [System.IO.File]::WriteAllText($resolvedFile, $jsonText, $utf8NoBom)
}

function Require-DriverPath {
    if ([string]::IsNullOrWhiteSpace($DriverPath)) {
        throw "DriverPath is required for $Command"
    }

    return Normalize-DriverPath -Path $DriverPath
}

switch ($Command) {
    'GetRuntime' {
        $json = Read-OpenVrPaths
        $runtime = @(Get-RuntimeEntries -JsonObject $json)
        $runtime[0]
    }

    'AddExternalDriver' {
        $driverPath = Require-DriverPath
        $json = Read-OpenVrPaths
        $current = @(Get-ExternalDriverEntries -JsonObject $json)
        $normalizedCurrent = @($current | ForEach-Object { Normalize-DriverPath -Path $_ })
        if ($normalizedCurrent -notcontains $driverPath) {
            Set-JsonArrayProperty -JsonObject $json -PropertyName 'external_drivers' -Value ($current + $driverPath)
            Write-OpenVrPaths -JsonObject $json
        }
    }

    'RemoveExternalDriver' {
        $driverPath = Require-DriverPath
        $json = Read-OpenVrPaths
        $current = @(Get-ExternalDriverEntries -JsonObject $json)
        $updated = @($current | Where-Object { (Normalize-DriverPath -Path $_) -ne $driverPath })
        if ($updated.Count -ne $current.Count) {
            Set-JsonArrayProperty -JsonObject $json -PropertyName 'external_drivers' -Value $updated
            Write-OpenVrPaths -JsonObject $json
        }
    }
}
