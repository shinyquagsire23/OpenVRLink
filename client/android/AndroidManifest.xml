<!-- Android manifest for OpenVRLink on OpenXR headsets (Android XR, Quest, Pico, Lynx). Android's built-in
     NativeActivity loads libOpenVRLinkAndroid.so (Sources/OpenVRLinkAndroid) without custom Java or Kotlin code.
     build.sh substitutes @PACKAGE@, @VERSION@, @BUILD@, and @MIN_SDK@, and puts the launcher category on
     the immersive activity by default; with its "flat" option it instead keeps the flat panel alias and makes
     that the launcher entry. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@PACKAGE@"
    android:versionCode="@BUILD@"
    android:versionName="@VERSION@">

    <uses-sdk android:minSdkVersion="@MIN_SDK@" android:targetSdkVersion="34" />

    <!-- Request Vulkan 1.1 and OpenXR 1.0. The OpenXR feature is marked optional because non-Android XR headsets
         provide an OpenXR runtime without declaring android.software.xr.api.openxr. -->
    <uses-feature android:name="android.software.xr.api.openxr" android:version="0x00010000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to acquire a low-latency WifiManager.WifiLock while streaming (including Quest's vendor Wi-Fi lock permission). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.oculus.permission.WIFI_LOCK" />
    <!-- Requested at runtime when starting a stream with "Send my microphone" enabled. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Requested at runtime when the immersive activity starts on Android XR. -->
    <uses-permission android:name="android.permission.HAND_TRACKING" />
    <!-- Requested at runtime on Android XR before OpenXR exposes eye gaze and face tracking. -->
    <uses-permission android:name="android.permission.EYE_TRACKING_FINE" />
    <uses-feature android:name="android.hardware.xr.input.eye_tracking" android:required="false" />
    <uses-permission android:name="android.permission.FACE_TRACKING" />
    <uses-feature android:name="android.hardware.xr.input.controller" android:required="false" />
    <uses-feature android:name="android.hardware.xr.input.hand_tracking" android:required="false" />
    <!-- Requested at runtime for OpenXR eye gaze on Quest Pro and on Pico headsets that track eyes. -->
    <uses-permission android:name="com.oculus.permission.EYE_TRACKING" />
    <!-- Requested at runtime for XR_FB_face_tracking2 on Quest Pro (and Quest 3's audio-driven face). -->
    <uses-permission android:name="com.oculus.permission.FACE_TRACKING" />
    <uses-feature android:name="oculus.software.face_tracking" android:required="false" />
    <uses-feature android:name="oculus.software.eye_tracking" android:required="false" />
    <uses-permission android:name="com.picovr.permission.EYE_TRACKING" />
    <!-- Granted at install time for hand tracking on Quest. -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <!-- Required by XR_FB_render_model to query controller render models on Quest headsets. -->
    <uses-permission android:name="com.oculus.permission.RENDER_MODEL" />
    <uses-feature android:name="com.oculus.feature.RENDER_MODEL" android:required="false" />

    <!-- Permissions and package-visibility queries required by the Khronos OpenXR Android loader. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application android:label="OpenVRLink" android:icon="@mipmap/icon" android:hasCode="false" android:extractNativeLibs="true">
        <!-- Android XR's OpenXR runtime is a system library that apps can only load after naming it here. -->
        <uses-native-library android:name="libopenxr.google.so" android:required="false" />
        <meta-data android:name="com.oculus.supportedDevices" android:value="all" />
        <meta-data android:name="com.oculus.intent.category.VR" android:value="vr_only" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <meta-data android:name="com.yvr.intent.category.VR" android:value="vr_only" />
        <meta-data android:name="pvr.app.type" android:value="vr" />
        <meta-data android:name="pvr.sdk.version" android:value="OpenXR" />
        <!-- Declares 6DoF headset and dual-controller support for Vive launchers. -->
        <meta-data android:name="com.htc.vr.content.NumDoFHmd" android:value="6DoF" />
        <meta-data android:name="com.htc.vr.content.NumDoFController" android:value="6DoF" />
        <meta-data android:name="com.htc.vr.content.NumController" android:value="2" />
        <!-- Requests system room-boundary rendering on Android XR during opaque full-space streaming. -->
        <property android:name="android.window.PROPERTY_XR_BOUNDARY_TYPE_RECOMMENDED" android:value="XR_BOUNDARY_TYPE_LARGE" />

        <!-- Immersive activity that runs the OpenXR session with the panel rendered as a quad layer. -->
        <activity android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:resizeableActivity="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="OpenVRLinkAndroid" />
            <meta-data android:name="pvr.app.type" android:value="vr" />
            <!-- Launch directly into unmanaged full-space OpenXR rendering rather than 2D system panels. -->
            <property android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_UNMANAGED" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                @IMMERSIVE_LAUNCHER@
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="com.yvr.intent.category.VR" />
            </intent-filter>
        </activity>

        <!-- @FLAT_ONLY_BEGIN@ build.sh leaves everything up to the matching end marker out unless run with its flat option:
             on Galaxy XR the home screen opened this entry even without the launcher category. -->
        <!-- 2D panel window that launches the immersive activity once the user selects a host. We use an
             activity-alias because the APK has no custom Java subclasses, and native code checks the launched
             component name to distinguish between the 2D window and the immersive activity.
             Android XR (tested on Galaxy XR) puts this alias in unmanaged full space like its target, whatever
             start-mode property the alias carries, and a 2D window there gets no pointer; use the immersive
             launcher on that system. -->
        <activity-alias android:name=".Panel"
            android:targetActivity="android.app.NativeActivity"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="OpenVRLinkAndroid" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- @FLAT_ONLY_END@ -->
    </application>
</manifest>
